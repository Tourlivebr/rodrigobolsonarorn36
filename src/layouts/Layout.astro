---
import '@styles/global.css';
import { siteConfig } from '@data/site';
import { proposals } from '@data/proposals';
import { faqItems } from '@data/faq';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  keywords?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description = siteConfig.description,
  image = `${siteConfig.url}/og-image.jpg`,
  canonical,
  type = 'website',
  noIndex = false,
  keywords = [
    'Rodrigo de Bolsonaro',
    'Rodrigo de Bolsonaro RN',
    'Pré-candidato Rodrigo de Bolsonaro',
    'Governo do RN 2026',
    'Eleições 2026 Rio Grande do Norte',
    'Propostas Rodrigo de Bolsonaro',
    'Plano de governo RN 2026',
    'AGIR RN',
    'Saúde pública RN',
    'Segurança pública RN',
    'Educação RN',
    'Infraestrutura RN',
    'Desenvolvimento econômico RN',
    'Natal',
    'Mossoró',
    'Caicó',
    'Pau dos Ferros',
    'Nova Cruz',
    'João Câmara',
  ],
  breadcrumbs = [
    { name: 'Início', url: siteConfig.url + '/' },
  ],
} = Astro.props;

const fullTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.title;
const canonicalHref = canonical ?? Astro.url.pathname;
const canonicalURL = new URL(canonicalHref, Astro.site ?? siteConfig.url).toString();
const imageURL = image.startsWith('http') ? image : new URL(image, Astro.site ?? siteConfig.url).toString();

const jsonLdPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.author.name,
  givenName: 'Rodrigo',
  familyName: 'Bolsonaro',
  alternateName: 'Rodrigo de Bolsonaro 36',
  description: siteConfig.author.bio,
  disambiguatingDescription: siteConfig.author.candidato,
  url: siteConfig.url,
  image: imageURL,
  birthDate: undefined,
  email: siteConfig.contact.email || undefined,
  homeLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'RN',
      addressLocality: siteConfig.author.cidade,
      addressCountry: 'BR',
    },
  },
  jobTitle: siteConfig.author.candidato,
  memberOf: [
    {
      '@type': 'PoliticalParty',
      name: siteConfig.author.partido,
      alternateName: 'AGIR',
      url: 'https://agir.org.br/',
      areaServed: 'Rio Grande do Norte',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'RN',
    addressLocality: siteConfig.author.cidade,
    addressCountry: 'BR',
  },
  nationalHonorificPrefix: 'Sr.',
  honorificPrefix: 'Pré-candidato',
  religion: siteConfig.author.religiao,
  knowsAbout: [
    'Saúde Pública',
    'Desenvolvimento Econômico',
    'Infraestrutura',
    'Segurança Pública',
    'Educação',
    'Ação Social',
    'Esporte',
    'Rio Grande do Norte',
    'Eleições 2026',
  ],
  sameAs: Object.values(siteConfig.social).filter((s: string) => Boolean(s) && s.startsWith('http')),
};

const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  headline: siteConfig.title,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: 'pt-BR',
  copyrightYear: new Date().getFullYear(),
  copyrightHolder: { '@type': 'Person', name: siteConfig.author.name },
  publisher: { '@type': 'Person', name: siteConfig.author.name },
  image: imageURL,
  potentialAction: [
    {
      '@type': 'SearchAction',
      target: `${siteConfig.url}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  ],
  mainEntityOfPage: siteConfig.url,
};

const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: `${siteConfig.author.name} — Portal Informativo`,
  legalName: siteConfig.author.name,
  url: siteConfig.url,
  logo: new URL('/img/Logo_Rodrigobolsonaro36.png', Astro.site ?? siteConfig.url).toString(),
  image: imageURL,
  description: siteConfig.description,
  email: siteConfig.contact.email || undefined,
  address: {
    '@type': 'PostalAddress',
    addressLocality: siteConfig.author.cidade,
    addressRegion: 'RN',
    addressCountry: 'BR',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'Atendimento Institucional',
      email: siteConfig.contact.email || undefined,
      areaServed: 'BR-RN',
      availableLanguage: ['Portuguese', 'pt-BR'],
    },
  ],
  sameAs: Object.values(siteConfig.social).filter((s: string) => Boolean(s) && s.startsWith('http')),
  areaServed: 'Rio Grande do Norte',
};

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.url, Astro.site ?? siteConfig.url).toString(),
  })),
};

const jsonLdFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.slice(0, 8).map((f: { pergunta: string; resposta: string }) => ({
    '@type': 'Question',
    name: f.pergunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.resposta,
    },
  })),
};

const jsonLdItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Propostas de Governo — Categorias',
  description: 'Quatro áreas principais do plano institucional apresentado.',
  itemListElement: proposals.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: p.titulo,
      headline: p.titulo,
      description: p.resumo,
      url: new URL(`/propostas/${p.slug}`, Astro.site ?? siteConfig.url).toString(),
      about: p.categoria,
      inLanguage: 'pt-BR',
      image: p.imagem.startsWith('http') ? p.imagem : new URL(p.imagem, Astro.site ?? siteConfig.url).toString(),
    },
  })),
};
---

<!doctype html>
<html lang="pt-BR" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="content-language" content="pt-BR" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={siteConfig.name} />
    <meta name="apple-mobile-web-app-title" content={siteConfig.shortName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#009c3b" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#002776" media="(prefers-color-scheme: dark)" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={siteConfig.author.name} />
    <meta name="creator" content={siteConfig.author.name} />
    <meta name="copyright" content={`© ${new Date().getFullYear()} ${siteConfig.author.name}`} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow, noarchive, nosnippet, notranslate' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1, notranslate'} />
    <meta name="googlebot" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="bingbot" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="rating" content="general" />
    <meta name="audience" content="Eleitores, Rio Grande do Norte, Brasil" />
    <meta name="coverage" content="Worldwide" />
    <meta name="distribution" content="global" />
    <meta name="revisit-after" content="3 days" />
    <meta name="doc-type" content="Public" />
    <meta name="doc-class" content="Institutional" />
    <meta name="doc-rights" content="Public" />
    <meta name="abstract" content={description} />
    <meta name="subject" content="Portal informativo institucional sobre Rodrigo de Bolsonaro e as propostas apresentadas para o Rio Grande do Norte nas eleições de 2026." />
    <meta name="category" content="Política, Institucional, Informação, Eleições, Governo, Rio Grande do Norte, Brasil, 2026." />
    <meta name="language" content="Portuguese, pt-BR" />
    <meta name="target" content="all" />
    <meta name="geo.region" content="BR-RN" />
    <meta name="geo.placename" content="Natal" />
    <meta name="geo.position" content="-5.79448;-35.211" />
    <meta name="ICBM" content="-5.79448, -35.211" />
    <meta name="DC.title" content={fullTitle} />
    <meta name="DC.description" content={description} />
    <meta name="DC.language" content="pt-BR" />
    <meta name="DC.subject" content="Política, Eleições, Rio Grande do Norte, Rodrigo de Bolsonaro, Governo" />
    <meta name="DC.type" content="Text" />
    <meta name="DC.identifier" content={canonicalURL} />
    <meta name="DC.publisher" content={siteConfig.author.name} />
    <meta name="DC.rights" content={`© ${new Date().getFullYear()} ${siteConfig.author.name}`} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/Logo_Rodrigobolsonaro36.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/img/Logo_Rodrigobolsonaro36.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/Logo_Rodrigobolsonaro36.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#009c3b" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#009c3b" />
    <meta name="msapplication-TileImage" content="/img/Logo_Rodrigobolsonaro36.png" />
    <meta name="msapplication-tap-highlight" content="no" />

    <meta property="fb:app_id" content="" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="pt_PT" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="article:author" content={siteConfig.author.name} />
    <meta property="article:publisher" content={siteConfig.url} />
    <meta property="article:tag" content="Rodrigo de Bolsonaro" />
    <meta property="article:tag" content="Rio Grande do Norte" />
    <meta property="article:tag" content="Eleições 2026" />
    <meta property="article:tag" content="Plano de governo" />
    <meta property="article:section" content="Institucional" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.social.x && siteConfig.social.x.includes('x.com') ? `@${siteConfig.social.x.split('/').pop()}` : ''} />
    <meta name="twitter:creator" content={siteConfig.social.x && siteConfig.social.x.includes('x.com') ? `@${siteConfig.social.x.split('/').pop()}` : ''} />
    <meta name="twitter:domain" content={new URL(siteConfig.url).hostname} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={fullTitle} />
    <meta name="twitter:label1" content="Escritório" />
    <meta name="twitter:data1" content="Natal — Rio Grande do Norte" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdPerson)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdWebSite)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdOrganization)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdBreadcrumb)} />
    {Astro.url.pathname === '/' && (
      <>
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdFAQ)} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdItemList)} />
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <main class="flex-1" id="main-content">
      <slot />
    </main>
  </body>
</html>
