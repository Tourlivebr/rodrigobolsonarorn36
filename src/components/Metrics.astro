---
import { metrics } from '@data/metrics';
---

<section class="section bg-rn-blue relative overflow-hidden">
  <div class="absolute inset-0 opacity-10" aria-hidden="true">
    <div class="absolute top-0 left-0 w-80 h-80 rounded-full bg-rn-green blur-3xl" />
    <div class="absolute bottom-0 right-0 w-96 h-96 rounded-full bg-rn-yellow blur-3xl" />
  </div>
  <div class="container-wide px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <span class="tag-label bg-white/15 text-white border border-white/20 mb-4">
        Metas Propostas
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-white mb-4 text-balance">
        Principais Metas Apresentadas
      </h2>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto">
        Abaixo, números e indicadores que compõem as propostas apresentadas como parte do plano.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {
        metrics.map((metric) => (
          <article class="relative bg-white/10 backdrop-blur-sm border border-white/15 rounded-2xl p-5 md:p-6 text-white hover:bg-white/15 transition-colors">
            <p class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-rn-yellow leading-none mb-3">
              {metric.numero}
            </p>
            <p class="font-bold text-sm md:text-base lg:text-lg leading-tight mb-2">
              {metric.rotulo}
            </p>
            <p class="text-xs md:text-sm text-white/70 leading-relaxed">
              {metric.descricao}
            </p>
            <span class="sr-only">Proposta apresentada</span>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-white/70">
      * Dados referentes a propostas apresentadas.
    </p>
  </div>
</section>
