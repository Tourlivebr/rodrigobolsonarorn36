---
import { siteConfig } from '@data/site';

const { author } = siteConfig;

interface AboutItem {
  label: string;
  value: string;
}

const aboutItems: AboutItem[] = [
  { label: 'Ocupação', value: author.ocupacao },
  { label: 'Naturalidade', value: `${author.cidade}/${(author.estado as string).split(' ').pop() ?? 'RN'}` },
  { label: 'Idade', value: `${author.idade} anos` },
  { label: 'Fé', value: author.religiao },
  { label: 'Orientação', value: author.orientacao },
  { label: 'Vinculo partidário', value: author.partido },
];
---

<section id="quem-e" class="section bg-white">
  <div class="container-wide px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="relative w-full flex items-center justify-center">
        <img
          src="/img/rodrigobolsonaro.jpeg"
          alt={`Retrato institucional de ${author.name}`}
          loading="lazy"
          decoding="async"
          class="w-full h-auto max-w-full object-contain rounded-2xl shadow-sm ring-1 ring-slate-900/5"
        />
      </div>

      <div>
        <span class="tag-label bg-rn-green/10 text-rn-green mb-4">
          Perfil Institucional
        </span>
        <h2 class="section-title text-balance">
          Quem é {author.name}
        </h2>
        <p class="text-pretty text-lg md:text-xl text-slate-700 mb-6 leading-relaxed">
          {author.bio}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          {
            aboutItems.map((item) => (
              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                <span class="mt-0.5 w-2 h-2 rounded-full bg-rn-blue shrink-0" />
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                    {item.label}
                  </p>
                  <p class="text-sm md:text-base font-semibold text-slate-900">
                    {item.value}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <blockquote class="relative pl-5 border-l-4 border-rn-green rounded-r-lg py-2 bg-rn-green/5">
          <p class="font-display font-bold text-lg md:text-xl text-rn-blue leading-snug">
            “{author.lema}”
          </p>
        </blockquote>
      </div>
    </div>
  </div>
</section>
