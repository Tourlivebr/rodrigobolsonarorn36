---
import { proposals } from '@data/proposals';
import ProposalCard from './ProposalCard.astro';
---

<section id="propostas" class="section bg-slate-50/60">
  <div class="container-wide px-4">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <span class="tag-label bg-rn-blue/10 text-rn-blue mb-4">
        Propostas Apresentadas
      </span>
      <h2 class="section-title text-balance">
        Propostas de Governo
      </h2>
      <p class="section-subtitle mx-auto mb-0">
        Conheça as propostas organizadas por área. Cada seção traz o detalhamento completo dos itens apresentados.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {proposals.map((proposal) => <ProposalCard proposal={proposal} />)}
    </div>

    <div class="mt-10 text-center text-sm text-slate-500">
      <p>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-rn-green"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd"/></svg>
          As informações acima são propostas apresentadas como parte do plano institucional.
        </span>
      </p>
    </div>
  </div>
</section>
