---
import { siteConfig } from '@data/site';
const { name, nav, social, author } = siteConfig;
---

<footer class="bg-slate-900 text-slate-200 pt-16 pb-8">
  <div class="container-wide px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <div class="lg:col-span-2">
        <a href="#inicio" class="flex items-center gap-3 mb-4" aria-label="Rodrigo Bolsonaro - Início">
          <div class="inline-flex items-center p-2 bg-white rounded-xl shadow-sm">
            <img
              src="/img/Logo_Rodrigobolsonaro36.png"
              alt={`${name} — Rio Grande do Norte`}
              loading="lazy"
              decoding="async"
              class="h-9 md:h-11 w-auto object-contain"
            />
          </div>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mb-6 tracking-wide uppercase whitespace-pre-wrap break-words">
          ELEICAO 2026 KARLO RODRIGO LUCIO VIEIRA GOVERNADOR  CNPJ 68.518.790/0001-35 MATRIZ
        </p>
        <ul class="flex flex-wrap gap-2" aria-label="Redes sociais">
          {[
            { label: 'Instagram', key: 'instagram', icon: `<path d="M15.5 7h.01M12 15.25a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z"/><path d="M2.5 8.5a6 6 0 0 1 6-6h7a6 6 0 0 1 6 6v7a6 6 0 0 1-6 6h-7a6 6 0 0 1-6-6v-7Z"/>` },
            { label: 'Facebook', key: 'facebook', icon: `<path fill-rule="evenodd" d="M12.01 2.013c-5.523 0-10 4.477-10 10 0 4.99 3.657 9.128 8.438 9.878v-6.987h-2.54V12.013h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.877h2.773l-.443 2.892h-2.33v6.987c4.781-.75 8.437-4.888 8.437-9.878 0-5.523-4.477-10-10-10Z" clip-rule="evenodd"/>` },
            { label: 'WhatsApp', key: 'whatsapp', icon: `<path fill-rule="evenodd" d="M12 2a10 10 0 1 0 5.533 18.334l3.92 1.033a.75.75 0 0 0 .945-.945l-1.032-3.92A10 10 0 0 0 12 2Zm-3.175 4.55c-.252-.566-.52-.583-.763-.591h-.653c-.213 0-.559.08-.855.397-.296.317-1.13 1.103-1.13 2.693 0 1.59 1.156 3.125 1.317 3.338.16.213 2.246 3.51 5.528 4.787 3.282 1.277 3.282.853 3.87.799.588-.053 1.898-.774 2.166-1.525.267-.751.267-1.395.186-1.525-.08-.133-.294-.213-.614-.373-.32-.16-1.898-.935-2.192-1.041-.293-.107-.507-.16-.72.16-.214.32-.826 1.041-1.012 1.254-.187.213-.374.24-.693.08-.32-.16-1.35-.497-2.574-1.587a9.69 9.69 0 0 1-1.788-2.218c-.166-.32-.017-.493.142-.653.143-.143.32-.373.48-.56.16-.187.213-.32.32-.533.106-.214.053-.4-.027-.56-.08-.16-.72-1.735-.987-2.375Z" clip-rule="evenodd"/>` },
            { label: 'YouTube', key: 'youtube', icon: `<path fill-rule="evenodd" d="M1.5 7.25c0-1.374.543-2.515 1.415-3.25.618-.52 1.43-.75 2.5-.75h13.17c1.07 0 1.882.23 2.5.75.872.735 1.415 1.876 1.415 3.25v9.5c0 1.374-.543 2.515-1.415 3.25-.618.52-1.43.75-2.5.75H5.415c-1.07 0-1.882-.23-2.5-.75C2.043 19.265 1.5 18.124 1.5 16.75v-9.5Zm8.25 2.5a.75.75 0 0 0-1.125.65v4.2c0 .53.577.86 1.037.64l4.25-2.1a.65.65 0 0 0 0-1.18l-4.25-2.1c.075-.037 0 .003 0 0 .038-.02 0 0 0 0l.088-.11Z" clip-rule="evenodd"/>` },
            { label: 'X', key: 'x', icon: `<path d="M17.026 2H20.5l-7.54 8.625L22 22h-6.828l-4.77-6.238L4.8 22H1.327l8.063-9.225L2 2h6.914l4.313 5.69L17.026 2Zm-2.39 18h1.895L7.51 4H5.488l9.148 16Z"/>` },
            { label: 'TikTok', key: 'tiktok', icon: `<path fill-rule="evenodd" d="M12 2.5a7 7 0 0 0 7 7v3a4 4 0 1 1-4-4V8.5a.5.5 0 0 1 .5-.5 2.5 2.5 0 0 0 0-5c-2.206 0-4 1.794-4 4v10a2.5 2.5 0 1 1-2.5-2.5.5.5 0 0 1 .5.5V14a4 4 0 1 0 3 3.873V5.5A5.5 5.5 0 1 0 12 2.5Z" clip-rule="evenodd"/>` },
          ].map((s) => {
            const href = social[s.key as keyof typeof social];
            return (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-slate-800 text-slate-300 border border-slate-700 hover:bg-rn-green hover:text-white hover:border-rn-green transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0.5" class="w-5 h-5" aria-hidden="true">
                    <Fragment set:html={s.icon} />
                  </svg>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-bold uppercase tracking-wider text-xs mb-4">
          Navegação
        </h3>
        <ul class="space-y-2">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-slate-400 hover:text-white transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-white font-bold uppercase tracking-wider text-xs mb-4">
          Informações
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#" class="text-slate-400 hover:text-white transition-colors">
              Política de Privacidade
            </a>
          </li>
          <li>
            <a href="#" class="text-slate-400 hover:text-white transition-colors">
              Termos de Uso
            </a>
          </li>
          <li class="text-slate-500 pt-2 border-t border-slate-800">
            {author.candidato}
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-6 text-center">
      <p class="text-xs text-slate-400 tracking-wide uppercase whitespace-pre-wrap break-words">
        ELEICAO 2026 KARLO RODRIGO LUCIO VIEIRA GOVERNADOR  CNPJ 68.518.790/0001-35 MATRIZ
      </p>
    </div>
  </div>
</footer>
