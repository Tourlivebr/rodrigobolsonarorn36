---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { proposals, getProposalBySlug } from '@data/proposals';
import { siteConfig } from '@data/site';

export function getStaticPaths() {
  return proposals.map((p) => ({
    params: { slug: p.slug },
    props: { proposal: p },
  }));
}

const { slug } = Astro.params;
const proposal = getProposalBySlug(slug!);

if (!proposal) {
  return Astro.redirect('/404');
}

const bannerBg: Record<string, string> = {
  'saude-publica': 'from-emerald-50 via-white to-rose-50',
  'desenvolvimento-economico-infraestrutura': 'from-sky-50 via-white to-amber-50',
  'seguranca-publica': 'from-blue-50 via-white to-amber-50',
  'educacao-acao-social-esporte': 'from-emerald-50 via-white to-yellow-50',
};

const seoKeywords = [
  proposal.categoria,
  proposal.titulo,
  'propostas',
  'plano de governo RN 2026',
  'Rodrigo de Bolsonaro',
  siteConfig.author.partido,
  'Rio Grande do Norte',
  'Natal',
  'eleições 2026',
];

const seoImage = proposal.imagem?.startsWith('http')
  ? proposal.imagem
  : new URL(proposal.imagem || '/og-image.jpg', Astro.site ?? siteConfig.url).toString();
---

<Layout
  title={`Propostas: ${proposal.titulo}`}
  description={proposal.resumo || proposal.descricao}
  image={seoImage}
  canonical={`/propostas/${proposal.slug}/`}
  keywords={seoKeywords}
  type="article"
  breadcrumbs={[
    { name: 'Início', url: siteConfig.url + '/' },
    { name: 'Propostas', url: siteConfig.url + '/#propostas' },
    { name: proposal.titulo, url: `${siteConfig.url}/propostas/${proposal.slug}/` },
  ]}
>
  <Header />

  <section class="relative bg-slate-50/60 pt-20 pb-10 md:pt-28 md:pb-16">
    <div class="container-wide px-4">
      <a
        href="/#propostas"
        class="inline-flex items-center gap-2 text-sm font-semibold text-rn-blue hover:text-rn-blue/80 mb-6"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Voltar para todas as propostas
      </a>

      <div class={`relative overflow-hidden rounded-3xl border border-slate-100 bg-gradient-to-br ${bannerBg[proposal.slug] || bannerBg['saude-publica']} mb-6 shadow-sm`}>
        <div class="grid grid-cols-1 md:grid-cols-5 items-stretch">
          <div class="md:col-span-2 aspect-[16/10] md:aspect-auto overflow-hidden">
            <img
              src={proposal.imagem}
              alt={proposal.imagemAlt ?? `Ilustração — ${proposal.titulo}`}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="md:col-span-3 p-6 md:p-10 flex flex-col justify-center">
            <span class="text-xs md:text-sm font-bold uppercase tracking-wide text-rn-green mb-3">
              Proposta Apresentada
            </span>
            <h1 class="text-3xl md:text-5xl font-display font-extrabold text-slate-900 mb-4 text-balance">
              {proposal.titulo}
            </h1>
            <p class="text-lg md:text-xl text-slate-600 leading-relaxed">
              {proposal.descricao}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-8 md:pt-10">
    <div class="container-wide px-4 max-w-5xl">
      <div class="card p-6 md:p-10">
        <div class="mb-8">
          <h2 class="text-2xl md:text-3xl font-display font-bold text-slate-900 mb-4">
            Resumo
          </h2>
          <p class="text-slate-700 leading-relaxed text-base md:text-lg">
            {proposal.resumo}
          </p>
        </div>

        <div class="border-t border-slate-100 pt-8">
          <h2 class="text-2xl md:text-3xl font-display font-bold text-slate-900 mb-6">
            Itens apresentados
          </h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
            {
              proposal.itens.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 inline-flex w-6 h-6 rounded-full bg-rn-green/10 text-rn-green items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
                      <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd"/>
                    </svg>
                  </span>
                  <span class="text-slate-800 text-sm md:text-base leading-relaxed">
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="text-center mt-8 text-sm text-slate-500">
        * Os itens acima são propostas apresentadas como parte do plano institucional de {siteConfig.author.name}.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <a href="/#propostas" class="btn-secondary w-full sm:w-auto">
          Ver todas as categorias
        </a>
        <a href="/#contato" class="btn-primary w-full sm:w-auto">
          Entrar em contato
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
